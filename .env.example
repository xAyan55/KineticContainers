# Port the web UI listens on (dev default 5173 for Vite, API default 8080)
PORT=8080
# Public URL of the API as seen by the browser (dev default points at local API).
# In production when the API serves the built frontend, leave as empty string.
VITE_API_BASE_URL=http://127.0.0.1:8080
# Path to the SQLite database file
DATABASE_PATH=./data/kineticct.sqlite
# Cookie / session settings
SESSION_COOKIE_NAME=kct_session
SESSION_TTL_HOURS=168
# Set to "production" to enable Secure cookies and strict checks
NODE_ENV=development
# Seed admin created on first boot when no users exist (change immediately after login)
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=ChangeMe123!_admin
SEED_ADMIN_NAME=Administrator
# CORS: comma-separated allowed browser origins for API access (dev default Vite)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Rate limit: max login attempts per 15 minutes per IP
LOGIN_RATE_LIMIT_MAX=20
